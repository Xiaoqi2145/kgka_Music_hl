# Normalize text files to LF in the repository; check out with native CRLF on Windows.
* text=auto eol=lf

# auto generated by UGit 
*.png filter=lfs diff=lfs merge=binary -text
*.jar filter=lfs diff=lfs merge=binary -text
*.pbxproj filter=lfs diff=lfs merge=binary -text
*.ico filter=lfs diff=lfs merge=binary -text
*.metadata filter=lfs diff=lfs merge=binary -text
